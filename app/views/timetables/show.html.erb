<%= form_with url: root_path, method: :get do | form | %>
  <%= form.date_field :date, value: @date, onchange: "this.form.requestSubmit()" %>
<% end %>
<div class="timetable-scroll">
  <div class="timetable-inner">
    <div class="time-row">
      <div class="time-label">
        部屋(定員人数)
      </div>
    <% @times.each do | time | %>
    <div class="time-cell <%= "hour" if time.min == 0 %>">
        <% if time.min == 0 %>
        <%= time.strftime("%H:%M") %>
      <% end %>  
    </div>
    <% end %>
    </div>


<% @rooms.each do | room | %>
  <div class="room-row">

    <div class="room-label">
      <%= room.name %> (定員<%= room.min_capacity %>~<%= room.max_capacity %>名) 
    </div>
  
    <div class="room-track">
      <div class="cell-layer">
        <% @times.each do | time | %>
          <%= link_to "", new_slot_path(room_id: room.id, start_at: time), class: "cell" %>
        <% end %>  
      </div>
        <% room.slots.where(start_at: @range).each do |slot| %>
          <%= link_to edit_slot_path(slot), class: "slot #{slot.kind}", style: "left: #{slot_start(slot)}%; width: #{slot_width(slot)}%;" do %>
            <%= slot.name %>
          <% end %>
          <%# slot.start_at %>
          <%# slot.end_at %>
        <% end %>  
    </div>    
  </div>
<% end %>

  </div>
</div>