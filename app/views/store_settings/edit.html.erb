<%= form_with model: @store, url: store_setting_path do | form | %>
  <%= form.label :name, "店舗名" %>
  <%= form.text_field :name %>
  <div>
    <%= form.label :open_time, "営業開始時間" %>
    <%= form.time_field :open_time %>
    <%= form.label :close_time, "営業終了時間" %>
    <%= form.time_field :close_time %>
  </div>  
  <%= form.submit "保存する" %>
<% end %>
